# -----------------------------------------------------------------------------
# TripFit LK - Environment Variables
# -----------------------------------------------------------------------------
# Google Gemini Free API Key
# 1. Get your 100% free API key at: https://aistudio.google.com
# 2. Rename this file to '.env' (or '.env.local')
# 3. Paste your key below:
# -----------------------------------------------------------------------------

VITE_GEMINI_API_KEY=your_free_gemini_api_key_here

# -----------------------------------------------------------------------------
# 12Go Asia Partner / Affiliate Transit API Key (Optional)
# For fetching live Sri Lanka Railways & intercity bus tickets
# -----------------------------------------------------------------------------
VITE_12GO_API_KEY=your_12go_api_key_here
